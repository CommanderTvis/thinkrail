{
	"name": "@thinkrail/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "bun run typography:check && bun run colors:check && bun run spacing:check && tsc --noEmit && vite build",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"preview": "vite preview",
		"typography:generate": "bun scripts/generate-typography.ts",
		"typography:validate": "bun scripts/validate-typography.ts",
		"typography:check": "bun scripts/generate-typography.ts --check",
		"colors:generate": "bun scripts/generate-colors.ts",
		"colors:check": "bun scripts/generate-colors.ts --check",
		"spacing:generate": "bun scripts/generate-spacing.ts",
		"spacing:check": "bun scripts/generate-spacing.ts --check"
	},
	"dependencies": {
		"@dnd-kit/core": "6.3.1",
		"@fontsource-variable/geist": "catalog:",
		"@fontsource-variable/jetbrains-mono": "catalog:",
		"@fontsource-variable/orbitron": "catalog:",
		"@monaco-editor/react": "4.7.0",
		"@remixicon/react": "4.9.0",
		"@thinkrail/contracts": "workspace:*",
		"@thinkrail/plugin-api": "workspace:*",
		"@thinkrail/plugin-spec-dialect": "workspace:*",
		"@thinkrail/plugin-ui": "workspace:*",
		"@xterm/addon-clipboard": "0.2.0",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-unicode11": "0.9.0",
		"@xterm/addon-web-fonts": "0.1.0",
		"@xterm/xterm": "6.0.0",
		"monaco-editor": "0.55.1",
		"node-htmldiff": "0.9.4",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-markdown": "10.1.0",
		"react-virtuoso": "4.18.7",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "6.0.2",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "8.0.16"
	}
}
