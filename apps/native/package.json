{
  "name": "thinkrail-native-prototype",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "macos": "bun run themes && react-native run-macos",
    "build:macos": "bun run themes && react-native build-macos --mode Release",
    "icons": "node generate-icons.mjs",
    "themes": "bun generate-themes.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "react-native start",
    "e2e": "../../node_modules/.bin/playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@shikijs/langs": "4.2.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-macos": "0.83.0",
    "react-native-markdown-display": "7.0.2",
    "shiki": "4.2.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@react-native-community/cli": "20.0.0",
    "@react-native-swc/core": "0.1.5",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/bun": "1.4.0",
    "@types/react": "19.3.0",
    "@types/ws": "8.18.1",
    "eslint": "8.57.1",
    "oxc-transform-react": "0.152.0",
    "typescript": "5.9.3",
    "ws": "8.18.3"
  },
  "overrides": {
    "@swc/core": "1.15.32"
  },
  "engines": {
    "node": ">=20"
  }
}
